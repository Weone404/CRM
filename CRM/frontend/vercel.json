{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [
    {
      "source": "/api/partner/attendance/by-mobile",
      "destination": "https://syytqcadmtgowckdnbqh.supabase.co/functions/v1/crm-attendance/partner/attendance/by-mobile"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
