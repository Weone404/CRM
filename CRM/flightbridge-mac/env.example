# FlightBridge engine on this Mac. This file stays private on the Mac (chmod 600): never commit it or paste it anywhere.
# Copy the values from Render > the CRM backend service > Environment.

# The same database connection string Render uses.
DATABASE_URL=PASTE_DATABASE_URL

# Render's FB_SECRETS_KEY (or its SECRET_KEY if FB_SECRETS_KEY is not there). It unlocks the API keys saved in
# FlightBridge AI > Settings. Put the same value in Supabase > Edge Functions > Secrets as FB_SECRETS_KEY.
FB_SECRETS_KEY=PASTE_FB_SECRETS_KEY

# Sending stays OFF. Change these only after an explicit decision to start outreach.
DRY_RUN=true
OUTBOUND_ENABLED=false

FB_RUNNER=mac-mini
# Optional: any other FlightBridge settings Render has (GROQ_API_KEY, HOSTINGER_MAIL_API_TOKEN, INBOUND_SOURCE, ...).
# FLIGHTBRIDGE_ENGINE=off pauses the engine on this Mac.
